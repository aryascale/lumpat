generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

model Event {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  eventDate          DateTime
  location           String?
  latitude           Float?
  longitude          Float?
  gpxFile            String?
  status             String              @default("upcoming")
  isActive           Boolean             @default(true)
  cutoffMs           Int?
  categoryStartTimes Json?
  logoUrl            String?
  bannerUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bibCustomPrice     Int                 @default(0)
  tshirtSizes        String?
  isDraft            Boolean             @default(false)
  publishAt          DateTime?
  banners            Banner[]
  categories         Category[]
  registrations      EventRegistration[]
}

model Category {
  id            String              @id @default(uuid())
  name          String
  eventId       String
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  price         Int                 @default(0)
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Banner {
  id        String   @id @default(uuid())
  eventId   String
  imageUrl  String
  alt       String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String   @unique
  password        String?
  name            String?
  phoneNumber     String?
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  googleId        String?  @unique
  role            String   @default("user")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventRegistration {
  id             String    @id @default(uuid())
  eventId        String
  categoryId     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bibName        String?
  bloodType      String?
  email          String
  emergencyName  String?
  emergencyPhone String?
  gender         String
  grossAmount    Int       @default(0)
  name           String
  notes          String?   @db.Text
  orderId        String    @unique
  paidAt         DateTime?
  paymentMethod  String?
  paymentStatus  String    @default("pending")
  phoneNumber    String
  snapToken      String?
  snapUrl        String?
  tshirtSize     String?
  dateOfBirth    DateTime?
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([email, eventId])
  @@index([eventId])
  @@index([categoryId])
  @@index([orderId])
  @@index([paymentStatus])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  eventId   String?
  action    String
  detail    String?  @db.Text
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([action])
  @@index([createdAt])
}
