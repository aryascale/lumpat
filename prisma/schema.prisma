generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

model Event {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  eventDate          DateTime
  location           String?
  latitude           Float?
  longitude          Float?
  gpxFile            String?
  status             String     @default("upcoming")
  isActive           Boolean    @default(true)
  cutoffMs           Int?
  categoryStartTimes Json?
  logoUrl            String?
  bannerUrl          String?
  tshirtSizes        String?    // Comma-separated sizes e.g. "S,M,L,XL,XXL"
  bibCustomPrice     Int        @default(0) // Extra charge for custom BIB name (Rp)
  categories         Category[]
  banners            Banner[]
  registrations      EventRegistration[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Category {
  id            String   @id @default(uuid())
  name          String
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  price         Int      @default(0) // Price in Rupiah
  registrations EventRegistration[]
  createdAt     DateTime @default(now())

  @@unique([eventId, name])
  @@index([eventId])
}

model Banner {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl  String
  alt       String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([eventId])
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String   @unique
  password        String?
  name            String?
  phoneNumber     String?
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  googleId        String?  @unique
  role            String   @default("user")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventRegistration {
  id               String   @id @default(uuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Participant info (no login required)
  email            String
  name             String
  phoneNumber      String
  gender           String   // L or P
  bloodType        String?  // A, B, AB, O
  emergencyName    String?
  emergencyPhone   String?
  tshirtSize       String?
  bibName          String?  // Custom BIB name (max 12 chars)
  notes            String?  @db.Text
  // Payment
  orderId          String   @unique
  grossAmount      Int      @default(0)
  paymentStatus    String   @default("pending") // pending, settlement, expire, cancel
  paymentMethod    String?
  snapToken        String?
  snapUrl          String?
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([email, eventId])
  @@index([eventId])
  @@index([categoryId])
  @@index([orderId])
  @@index([paymentStatus])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  eventId   String?
  action    String
  detail    String?  @db.Text
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([action])
  @@index([createdAt])
}
